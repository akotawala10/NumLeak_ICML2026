# Copy to .env and fill in. .env is gitignored.
# Only the keys for models you actually intend to probe need to be set.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=

# Azure OpenAI (GPT-5.4 / mini / nano on Cognitive Services).
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_DEPLOYMENT_MINI=
AZURE_OPENAI_DEPLOYMENT_NANO=
AZURE_OPENAI_API_VERSION=

# Azure AI Foundry (DeepSeek-V3.2, Llama-4-Maverick).
AZURE_DEEPSEEK_API_KEY=
AZURE_DEEPSEEK_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_DEPLOYMENT_LLAMA4=
AZURE_FOUNDRY_DEPLOYMENT_DEEPSEEK_V32=

# Azure GPT-5.5 (separate Azure OpenAI resource on Responses API).
AZURE_GPT55_API_KEY=
AZURE_GPT55_ENDPOINT=
AZURE_GPT55_DEPLOYMENT=
AZURE_GPT55_API_VERSION=
